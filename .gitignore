# =========================
# GHDL Specific
# =========================

# GHDL library compilation files (e.g., work-obj93.cf, work-obj08.cf)
*.cf

# Object files generated during analysis/elaboration
*.o

# Waveform dump files (used with GTKWave or similar)
*.vcd
*.ghw
*.fst

# =========================
# Executables & Binaries
# =========================

# Windows executables generated by GHDL elaboration
*.exe

# Note: On Linux/macOS, GHDL generates executables without an extension 
# (e.g., if your entity is 'tb_adder', the executable is just 'tb_adder').
# It is highly recommended to output these to a specific build directory 
# and ignore the entire directory, like so:
# build/
# out/
# bin/

# =========================
# Simulation Logs & Outputs
# =========================

*.log
*.out
transcript

# =========================
# Editor & OS Temp Files
# =========================

# GTKWave save files (optional: comment out if you want to share waveform setups)
# *.sav

# OS generated files
.DS_Store
Thumbs.db

# Editor temp files
*~
*.swp
.vscode/
.idea/

# =========================
# Python (uv)
# =========================

.venv/
__pycache__/
*.pyc

# =========================
# 3DGS scene data
# =========================

# Pretrained Gaussian scenes are hundreds of MB - downloaded, never committed.
# See "Reproducing" in docs/phase0_findings.md for the download command.
models/data/scenes/
*.ply
*.npz
